#!/usr/bin/env python3

import curses
import os
import sys


def select(stdscr, items):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_WHITE)

    search = ""
    cursor = 0
    scroll = 0
    in_search = False

    while True:
        filtered = [item for item in items if search.lower() in item.lower()]

        if cursor >= len(filtered):
            cursor = max(0, len(filtered) - 1)

        stdscr.clear()
        height, width = stdscr.getmaxyx()
        list_height = height - 1

        if cursor < scroll:
            scroll = cursor
        elif cursor >= scroll + list_height:
            scroll = cursor - list_height + 1

        for i in range(list_height):
            idx = i + scroll
            if idx >= len(filtered):
                break
            display = filtered[idx][:width - 1]
            try:
                if idx == cursor:
                    stdscr.attron(curses.color_pair(1))
                    stdscr.addstr(i, 0, display.ljust(width - 1))
                    stdscr.attroff(curses.color_pair(1))
                else:
                    stdscr.addstr(i, 0, display)
            except curses.error:
                pass

        bar = f"/{search}_" if in_search else f"  {len(filtered)}/{len(items)}"
        try:
            stdscr.addstr(height - 1, 0, bar[:width - 1])
        except curses.error:
            pass

        stdscr.refresh()

        key = stdscr.getch()

        if in_search:
            if key == 27:  # Escape cancels search
                in_search = False
                search = ""
                cursor = 0
                scroll = 0
            elif key in (curses.KEY_ENTER, 10, 13):
                in_search = False
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                search = search[:-1]
                cursor = 0
                scroll = 0
            elif 32 <= key <= 126:
                search += chr(key)
                cursor = 0
                scroll = 0
        else:
            if key in (ord('j'), curses.KEY_DOWN):
                if filtered:
                    cursor = min(cursor + 1, len(filtered) - 1)
            elif key in (ord('k'), curses.KEY_UP):
                cursor = max(cursor - 1, 0)
            elif key == ord('/'):
                in_search = True
            elif key in (curses.KEY_ENTER, 10, 13):
                if filtered:
                    return filtered[cursor]
                return None
            elif key in (ord('q'), 27):
                return None


def main():
    items = sys.argv[1:]
    if not items:
        sys.exit(0)

    # Save real stdout, then point fd 0/1 at /dev/tty so curses doesn't
    # write escape sequences into the captured output pipe.
    real_stdout_fd = os.dup(sys.stdout.fileno())
    tty = open('/dev/tty', 'r+b', buffering=0)
    os.dup2(tty.fileno(), 0)
    os.dup2(tty.fileno(), 1)

    try:
        result = curses.wrapper(select, items)
    finally:
        os.dup2(real_stdout_fd, 1)
        os.close(real_stdout_fd)
        tty.close()

    if result is not None:
        print(result, end="")


if __name__ == "__main__":
    main()
