#! /usr/local/bin/python3
"""
Export the vt.relatives identity view to markdown.

Only works on vt.relatives broken down by Relation=w/ Identity.
Writes generated markdown to exported.md in the working directory.
"""

import sys

from jql import macro
from timedb.mdexport import generate_markdown


def main():
    with macro.macro_interface(sys.stdin, sys.stdout) as iface:
        markdown = generate_markdown(iface)
        with open("exported.md", "w") as f:
            f.write(markdown)


if __name__ == "__main__":
    main()
