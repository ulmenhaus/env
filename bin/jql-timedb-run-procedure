#! /usr/local/bin/python3
"""
For jql time management schema

* takes the selected pk and runs any procedure associated with doing it or prompts the user to select the procedure
"""

import base64
import os
import shutil
import subprocess
import sys

# The python gRPC client lib's pre-fork hook can cause a deadlock that
# prevents subprocess forking. Disabling fork support fixes this bug.
os.environ["GRPC_ENABLE_FORK_SUPPORT"] = "0"

from jql import jql_pb2, macro
from timedb import client_utils, schema

TEMPLATES_TABLE = "vt.templates"


def main():
    with macro.macro_interface(sys.stdin, sys.stdout) as iface:
        dbms = iface.get_dbms()
        table, pk = iface.get_primary_selection()
        if table != schema.Tables.Tasks:
            raise ValueError(table)
        resp = dbms.GetRow(jql_pb2.GetRowRequest(table=table, pk=pk))
        cmap = {c.name: i for i, c in enumerate(resp.columns)}
        action = resp.row.entries[cmap[schema.Fields.Action]].formatted
        direct = resp.row.entries[cmap[schema.Fields.Direct]].formatted
        indirect = resp.row.entries[cmap[schema.Fields.Indirect]].formatted
        procedure_resp = dbms.ListRows(
            jql_pb2.ListRowsRequest(
                table=schema.Tables.Assertions,
                conditions=[
                    jql_pb2.Condition(requires=[
                        jql_pb2.Filter(column=schema.Fields.Arg0,
                                       in_match=jql_pb2.InMatch(values=[
                                           f"nouns {noun}"
                                           for noun in [direct, indirect]
                                       ])),
                        jql_pb2.Filter(column=schema.Fields.Relation,
                                       equal_match=jql_pb2.EqualMatch(
                                           value=".Procedure")),
                    ]),
                ],
            ))
        assn_cmap = {c.name: i for i, c in enumerate(procedure_resp.columns)}
        procedures = [
            row for row in procedure_resp.rows if row.entries[assn_cmap[
                schema.Fields.Arg1]].formatted.startswith(f"### {action}")
        ]
        if len(procedures) == 1:
            procedure, = procedures
            body = procedure.entries[assn_cmap[schema.Fields.Arg1]].formatted
            template_pk = _template_reference(body)
            if template_pk is not None:
                _open_template(iface, template_pk)
                return
            steps = body.split("\n- ")[1:]
            if len(steps) == 1 and "```" in steps[0]:
                command = steps[0].split("```")[1].strip().format(indirect=indirect,direct=direct)
                subprocess.check_call(command, shell=True, env=os.environ)
                # TODO we should also update the parameters/attributes to include
                # the variation for record keeping in stats
                return
        # Fall back to the default behavior which is to open the prompt tool with
        # the right procedures preselected
        cmd = [
            "tmux",
            "popup",
            "-E",
            "-e",
            "TERM=xterm-256color",
            "/usr/local/bin/runner",
        ] + _client_args(iface) + [
            '--table',
            'no',
            '--init-type',
            'procedures',
            '--init-resource',
            direct,
            '--init-query',
            action,
            '--init-task-pk',
            pk,
            "--jql-bin-dir",
            # TODO hard-coding location of jql bin dir for now
            os.path.expanduser("~/src/github.com/ulmenhaus/env/bin"),
        ]
        subprocess.check_call(cmd)


def _client_args(iface):
    """Returns the flags for a jql-based tool to connect as a client to the
    same jql daemon this macro was invoked against"""
    args = ["--mode", "client", "--addr", iface.attrs['address']]
    tls_cert = iface.attrs.get("tls_cert", "")
    if tls_cert:
        args += [
            "--tls-cert",
            tls_cert,
            "--tls-key",
            iface.attrs["tls_key"],
            "--tls-ca",
            iface.attrs["tls_ca"],
        ]
    return args


def _template_reference(body):
    """If the body of a procedure (everything after its heading) is just a
    single reference to a template, e.g. @{vt.templates nouns Foo}, returns
    the template's pk within vt.templates (e.g. "nouns Foo"). Otherwise
    returns None."""
    lines = body.split("\n", 1)
    content = lines[1].strip() if len(lines) > 1 else ""
    if not (content.startswith("@{") and content.endswith("}")):
        return None
    if "\n" in content or content.count("@{") != 1:
        return None
    table, pk = client_utils.parse_foreign(content)
    if table != TEMPLATES_TABLE:
        return None
    return pk


def _open_template(iface, template_pk):
    """Opens a tmux pop-up running jql on vt.templates with the given
    template selected"""
    request = jql_pb2.ListRowsRequest(
        table=TEMPLATES_TABLE,
        conditions=[
            jql_pb2.Condition(requires=[
                jql_pb2.Filter(
                    column="-> Item",
                    equal_match=jql_pb2.EqualMatch(value=template_pk),
                ),
            ]),
        ],
    )
    query = base64.b64encode(request.SerializeToString()).decode("ascii")
    # XXX falling back to a hard-coded jql path (like runner's above) is not
    # portable but tmux pop-ups don't necessarily share our PATH
    jql = shutil.which("jql") or "/usr/local/bin/jql"
    cmd = [
        "tmux",
        "popup",
        "-h",
        "75%",
        "-w",
        "75%",
        "-E",
        "-e",
        "TERM=xterm-256color",
        jql,
    ] + _client_args(iface) + [
        "--query",
        query,
    ]
    subprocess.check_call(cmd)


if __name__ == "__main__":
    main()
