#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import tempfile


def main():
    text = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        # Make a best effort to make the text easier to edit if it's JSON
        text = json.dumps(json.loads(text), indent=4)
    except:
        pass

    with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False) as f:
        f.write(text)
        tmp_path = f.name

    try:
        subprocess.run(['vim', tmp_path], stdin=open('/dev/tty'), stdout=open('/dev/tty', 'w'))
        with open(tmp_path) as f:
            sys.stdout.write(f.read())
    finally:
        os.unlink(tmp_path)


if __name__ == "__main__":
    main()
